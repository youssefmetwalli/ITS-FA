# Firebase web app configuration used by the frontend/auth setup.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=

# Google Gemini/API key used by the AI features.
GOOGLE_API_KEY=

# Firebase Admin SDK service account JSON, base64 encoded.
# Generate a service account key in Firebase/Google Cloud, then encode it:
# base64 -i service-account.json
GOOGLE_CREDS_B64=

# Flask secret used to sign session cookies. Use a long random value.
SECRET_KEY=
